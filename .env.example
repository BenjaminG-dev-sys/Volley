# URL del backend InsForge (.insforge/project.json → oss_host)
NEXT_PUBLIC_INSFORGE_URL=https://xxxxxxxx.us-east.insforge.app
# Clave anónima: npx -y @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Clave de administración (solo servidor, para el seed): .insforge/project.json → api_key
INSFORGE_API_KEY=
